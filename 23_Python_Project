def get_pet(pet_id):
    if pet_id in pets:
        return pets[pet_id]
    else:
        return False


def get_suffix(age):
    if age % 10 == 1 and age % 100 != 11:
        return "год"
    elif age % 10 in (2, 3, 4) and age % 100 not in (12, 13, 14):
        return "года"
    else:
        return "лет"


