def read():
    pet_id = int(input("Назовите ID питомца: "))
    result = get_pet(pet_id)

    if result is False:
        print("Такого питомца нет")
    else:
        nickname = list(result.keys())[0]
        pet_info = result[nickname]

        kind = pet_info["Вид питомца"]
        age = pet_info["Возраст питомца"]
        owner = pet_info["Имя владельца"]
        suffix = get_suffix(age)

        print(
            f'Это {kind} по кличке "{nickname}". '
            f"Возраст питомца: {age} {suffix}. "
            f"Имя владельца: {owner}"
        )


def update():
    pet_id = int(input("Назовите ID питомца: "))
    result = get_pet(pet_id)

    if result is False:
        print("Питомец не найден")
    else:
        nickname = list(result.keys())[0]
        pet_info = result[nickname]

        kind = input("Введите новый вид питомца: ")
        age = int(input("Введите новый возраст питомца: "))
        owner = input("Введите новое имя владельца: ")

        pet_info["Вид питомца"] = kind
        pet_info["Возраст питомца"] = age
        pet_info["Имя владельца"] = owner

        print("Данные питомца обновлены")


def delete():
    pet_id = int(input("Назовите ID питомца: "))
    result = get_pet(pet_id)

    if result is False:
        print("Питомец не найден")
    else:
        del pets[pet_id]
        print("Питомец удалён")


def pets_list():
    if not pets:
        print("База данных пуста")
    else:
        for pet_id, pet_data in pets.items():
            nickname = list(pet_data.keys())[0]
            pet_info = pet_data[nickname]

            kind = pet_info["Вид питомца"]
            age = pet_info["Возраст питомца"]
            owner = pet_info["Имя владельца"]
            suffix = get_suffix(age)

            print(
                f'ID: {pet_id}. '
                f'Это {kind} по кличке "{nickname}". '
                f"Возраст питомца: {age} {suffix}. "
                f"Имя владельца: {owner}"
            )


command = ""

while command != "stop":
    print(
        "\nВыберите команду:\n"
        "create, read, update, delete, list, stop"
    )

    command = input("Введите команду: ")

    if command == "stop":
        break
    elif command == "create":
        create()
    elif command == "read":
        read()
    elif command == "update":
        update()
    elif command == "delete":
        delete()
    elif command == "list":
        pets_list()
    else:
        print("Неизвестная команда")


