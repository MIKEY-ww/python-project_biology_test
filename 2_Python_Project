#Запрашиваем данные о питомце(вид):
data = input("Кем ялвяется ваш питомец?")

#Запрашиваем возраст питомца:
age = input("Сколько лет вашему питомцу?")

#Запрашиваем имя питомца:
name = input("Кличка вашего питомца?")

#Обьединяем всю полученную информацию о питомце и выводим её на экран:
print("Вид:", data)
print("Ворзраст:", age,'лет')
print("Имя:", name)