# Придумываем пятизначное число:
# Моё число 74362
print("Введите пятизначное число")
n = int(input())

# Разубираем пятизначное число по цифрам.
# 74362 % 10 = 2
# 74362 // 10 % 10 = 6
# 74362 // 100 % 10 = 3
# 74362 // 1000 % 10 = 4
# 74362 // 10000 % 10 = 7
units = n % 10
tens = (n // 10) % 10
hundreds = (n // 100) % 10
thousands = (n // 1000) % 10
ten_thousands = (n // 10000) % 10

#Запписываем результат подставляя цифры.
# (6**2)*3/(7-5) 
result = ( tens ** units) * hundreds / (ten_thousands - thousands)

print("Итого:", result)