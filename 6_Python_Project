# Ввводим любое число в терминал.
print("Проверка вашего числа:")
Number = int(input())

# Создаём условие для проверки числа.
if (Number > 0) and (Number // 2):
    print("Число", Number, "положительное чётное")

elif (Number > 0) and (Number & 2):
    print("Число", Number, "положительное нечётное")

elif (Number < 0) and (Number //2):
    print("Число", Number, "отрицательное чётное")

elif (Number < 0) and (Number % 2):
    print("Число", Number, "отрицательное нечётное")

# Если не какое условие не подошло значит "нулевое".
else:
    print("Число", Number, "нулевое")