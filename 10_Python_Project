# Придумываем число Х
# Создаём счётчик
x = int(input())
count = 0

# Создаём цикл в котором перебираем числа только до корня х.
# В условии указываем что парные делители учитываются по 2, а одинаковые по 1.
for i in range(1,int(x**0.5)+1):
    if x % i == 0:
        if i * i == x:
            count +=1
        else:
            count +=2 

print("Количество делителей", count)
